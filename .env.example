# Copy to .env and adjust. Secrets do NOT go here — see secrets/README.md.
# Prefixes say which service a variable configures: bare vault/sync vars,
# MCP_* for the MCP server, DASHBOARD_* for the dashboard.

# --- Sync ---------------------------------------------------------
# Name of the remote Obsidian Sync vault
VAULT_NAME=Notes
# UID/GID that should own vault files on the host
PUID=1000
PGID=1000
# Device label shown in Obsidian Sync's device list
DEVICE_NAME=mimir
CONFLICT_STRATEGY=merge

# --- MCP server ---------------------------------------------------
# Public origin of the MCP endpoint (feeds OAuth URL pinning)...
MCP_PUBLIC_URL=https://mimir.example.com
# ...and its bare hostname (feeds the Host-header allowlist). Both are needed
# because compose can't derive one from the other; keep them in agreement.
MCP_PUBLIC_HOST=mimir.example.com
# Username for the OAuth browser login (password is a secret file)
MCP_OAUTH_USERNAME=obsidian
# Optional daily-notes config
MCP_DAILY_NOTES_FOLDER=
MCP_DAILY_NOTES_FORMAT=%Y-%m-%d
# Optional: Healthchecks.io ping URL (or any push monitor) — the MCP server
# GETs it every MCP_HEARTBEAT_INTERVAL seconds while healthy
MCP_HEARTBEAT_URL=
MCP_HEARTBEAT_INTERVAL=60

# --- Dashboard ----------------------------------------------------
# Your tailnet login exactly as `tailscale status` shows it (fail-closed if empty)
DASHBOARD_TAILSCALE_USER=
DASHBOARD_PORT=8787
DASHBOARD_POLL_SECONDS=10
